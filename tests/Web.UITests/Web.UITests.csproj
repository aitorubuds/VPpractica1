<Project Sdk="MSTest.Sdk/4.5.1">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Selenium Manager (incluido) descarga solo el driver de cada navegador -->
    <PackageReference Include="Selenium.WebDriver" Version="4.51.0" />
    <PackageReference Include="Selenium.Support" Version="4.51.0" />
    <!-- Para arrancar la web en un puerto real desde las pruebas -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Web\Web.csproj" />
  </ItemGroup>

</Project>
